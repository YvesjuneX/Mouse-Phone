{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Mouse Phone WebSocket message",
  "type": "object",
  "required": ["type"],
  "properties": {
    "type": { "enum": ["remote_mouse", "session_init", "session_offer", "secure", "confirm", "move", "move_end", "click", "scroll", "media"] },
    "dx": { "type": "number" },
    "dy": { "type": "number" },
    "amount": { "type": "integer" },
    "action": { "type": "string" },
    "name": { "type": "string" },
    "version": { "type": "integer" },
    "code": { "type": "string", "pattern": "^[0-9]{6}$" },
    "ok": { "type": "boolean" },
    "counter": { "type": "integer", "minimum": 1 },
    "nonce": { "type": "string" },
    "data": { "type": "string" },
    "mode": { "enum": ["qr", "code"] },
    "public": { "type": "string" }
  }
}
